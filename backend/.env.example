# Copy this file to .env and fill in the values. Never commit .env.

# SQLite works out of the box for local development.
# For PostgreSQL (Supabase / Neon / local):
#   DATABASE_URL=postgresql://user:password@host:5432/finsight
DATABASE_URL=sqlite:///./finsight.db

# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=720

# Comma-separated list of frontend URLs allowed to call this API.
FRONTEND_ORIGINS=http://localhost:3000

# Timezone used to decide what "today" and "this month" mean.
BUSINESS_TIMEZONE=Asia/Kolkata

# Optional: enables the Gemini-powered assistant (tool/function calling).
# Without it, FinSight uses its built-in rule-based assistant, which still
# answers every question from real database numbers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
